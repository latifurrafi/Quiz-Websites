# Copy to .env and fill in before deploying. Defaults are fine for local work.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me

# 0 in production. Never run a public site with DEBUG=1.
DJANGO_DEBUG=0

# Comma separated, no spaces.
DJANGO_ALLOWED_HOSTS=quiz.example.com,www.quiz.example.com

# Needed when serving over HTTPS behind a domain.
DJANGO_CSRF_TRUSTED_ORIGINS=https://quiz.example.com

# Set to 1 only once the site is genuinely served over HTTPS. It turns on
# secure cookies, an HTTPS redirect and HSTS -- on plain HTTP it breaks logins.
DJANGO_SECURE_HTTPS=0

# HSTS lifetime in seconds, used only when DJANGO_SECURE_HTTPS=1.
# Start small (3600). Raise it only once you are sure TLS is permanent.
DJANGO_HSTS_SECONDS=3600

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
# Host port to publish the site on. 8080 by default because port 8000 is
# commonly taken by other local projects. Change it if 8080 clashes too.
QUIZ_PORT=8080

# Where the SQLite file lives inside the container. Leave as-is; the
# compose file mounts a volume here so data survives rebuilds.
DJANGO_DB_PATH=/app/data/db.sqlite3

# The admin account, created on FIRST start only. An existing account is
# never touched, so editing this later will not change your password --
# use `docker compose exec quiz python manage.py changepassword admin`.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=aiclub-admin-2026
DJANGO_SUPERUSER_EMAIL=
